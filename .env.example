# Adres backendu FastAPI. Puste = ten sam origin (w dev działa proxy z vite.config.ts).
VITE_API_BASE_URL=

# Ścieżka bazowa builda. Puste = "/". Dla GitHub Pages ustaw np. /garmin-pulpit/
# (workflow .github/workflows/deploy.yml robi to automatycznie).
VITE_BASE=

# Cel proxy dla trybu `npm run dev` (nie trafia do builda produkcyjnego).
VITE_API_PROXY_TARGET=http://localhost:8000

# Klucza X-API-Key NIE wpisuj tutaj — podajesz go w Ustawieniach aplikacji,
# żeby nie trafił do publicznego bundla JS.

# Klucz Google AI Studio (Gemini). Można też wpisać go później w Ustawieniach aplikacji.
VITE_GEMINI_API_KEY=

# Domyślny model Gemini.
VITE_GEMINI_MODEL=auto
